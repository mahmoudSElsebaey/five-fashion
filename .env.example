# ===========================================
# AURALIS — Environment Variables Example
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/auralis

# JWT
JWT_ACCESS_SECRET=your_super_secure_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (or equivalent media service)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Client (Vite) ----------
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME=Auralis
