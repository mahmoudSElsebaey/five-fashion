# ===========================================
# FIVE FASHION — Environment Variables Example
# SECTION 02 — Production hardening notes
# ===========================================
# Copy relevant vars into server/.env and client/.env
# NEVER commit real secrets.

# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma-separated allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/five-fashion

# Production: must be random strings ≥ 32 chars (app refuses weak placeholders)
JWT_ACCESS_SECRET=your_super_secure_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
API_VERSION=0.3.0

# Optional media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Client (Vite) ----------
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME=FIVE Fashion

# ---------- Deploy checklist ----------
# 1. Set NODE_ENV=production on the API host
# 2. Set strong JWT secrets and real MONGODB_URI (e.g. Atlas)
# 3. Set CLIENT_URL to your Vercel (or other) frontend origin(s)
# 4. Set VITE_API_URL at build time to the public API URL
# 5. Health check: GET {API}/api/v1/health
