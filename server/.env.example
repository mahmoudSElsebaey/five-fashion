# ===========================================
# FIVE FASHION — Server Environment
# NEVER commit the real .env file
# ===========================================

NODE_ENV=development
PORT=5000

# Store frontend origin(s), comma-separated if needed
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/five-fashion

# JWT — REQUIRED in production, min 32 chars
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_xxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary — REQUIRED in production
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=five-fashion/products

API_VERSION=0.4.0
