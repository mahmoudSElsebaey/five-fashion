# ===========================================
# FIVE FASHION — Server Environment
# SECTION 02 — copy to .env — NEVER commit .env
# ===========================================

# development | production
NODE_ENV=development
PORT=5000

# CORS: single origin or comma-separated list for multiple frontends
# Example production: https://five-fashion.vercel.app,https://www.fivefashion.com
CLIENT_URL=http://localhost:5173

# MongoDB (required in production)
MONGODB_URI=mongodb://localhost:27017/five-fashion

# JWT — REQUIRED in production, min 32 chars, no placeholders
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_xxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional — shown on GET /api/v1/health
API_VERSION=1.0.0
